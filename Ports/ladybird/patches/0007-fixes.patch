diff --git a/Meta/CMake/lagom_compile_options.cmake b/Meta/CMake/lagom_compile_options.cmake
index 81580f6fdffa04c2533c05407c5a2978410222be..ca604963b00933030a7cc0fc498fa702105080cc 100644
