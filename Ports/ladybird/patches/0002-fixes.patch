 #    include <AK/Assertions.h>
 
diff --git a/Libraries/LibCore/Socket.cpp b/Libraries/LibCore/Socket.cpp
index 3ac07d2ccb574a3512f4f8e2744ce038369893fc..4d0cd68d7870d96880bfce157e2d410afa533c3d 100644
--- a/Libraries/LibCore/Socket.cpp
+++ b/Libraries/LibCore/Socket.cpp
@@ -334,9 +334,7 @@ ErrorOr<NonnullOwnPtr<LocalSocket>> LocalSocket::adopt_fd(int fd, PreventSIGPIPE
 
 ErrorOr<int> LocalSocket::receive_fd(int flags)
 {
-#if defined(AK_OS_SERENITY)
-    return Core::System::recvfd(m_helper.fd(), flags);
-#elif defined(AK_OS_LINUX) || defined(AK_OS_GNU_HURD) || defined(AK_OS_BSD_GENERIC) || defined(AK_OS_HAIKU)
+#if defined(AK_OS_LINUX) || defined(AK_OS_GNU_HURD) || defined(AK_OS_BSD_GENERIC) || defined(AK_OS_HAIKU) || defined(AK_OS_SERENITY)
     union {
         struct cmsghdr cmsghdr;
         char control[CMSG_SPACE(sizeof(int))];
@@ -375,9 +373,7 @@ ErrorOr<int> LocalSocket::receive_fd(int flags)
 
 ErrorOr<void> LocalSocket::send_fd(int fd)
 {
-#if defined(AK_OS_SERENITY)
-    return Core::System::sendfd(m_helper.fd(), fd);
-#elif defined(AK_OS_LINUX) || defined(AK_OS_GNU_HURD) || defined(AK_OS_BSD_GENERIC) || defined(AK_OS_HAIKU)
+#if defined(AK_OS_LINUX) || defined(AK_OS_GNU_HURD) || defined(AK_OS_BSD_GENERIC) || defined(AK_OS_HAIKU) || defined(AK_OS_SERENITY)
     char c = 'F';
     struct iovec iov {
         .iov_base = &c,
diff --git a/Libraries/LibCore/System.cpp b/Libraries/LibCore/System.cpp
index b8d52a6ab293ebb569da7017ccf9269759dda25b..688d546a040733b8cb126743c63a28c15571bc48 100644
--- a/Libraries/LibCore/System.cpp
+++ b/Libraries/LibCore/System.cpp
@@ -754,7 +754,7 @@ u64 physical_memory_bytes()
 ErrorOr<ByteString> current_executable_path()
 {
     char path[4096] = {};
-#if defined(AK_OS_LINUX) || defined(AK_OS_ANDROID)
+#if defined(AK_OS_LINUX) || defined(AK_OS_ANDROID) || defined(AK_OS_SERENITY)
     auto ret = ::readlink("/proc/self/exe", path, sizeof(path) - 1);
     // Ignore error if it wasn't a symlink
     if (ret == -1 && errno != EINVAL)
diff --git a/Libraries/LibJS/Runtime/ExecutionContext.h b/Libraries/LibJS/Runtime/ExecutionContext.h
index e514dd9af5a9d1e69239710cb35dd2c9480c383c..dcacd13d7f3d91adfb287148f0a6a6ed4af07f69 100644
