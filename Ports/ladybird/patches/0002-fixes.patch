diff --git a/UI/CMakeLists.txt b/UI/CMakeLists.txt
index d02cec2d0c5df08f5957ed98c554a41e97efee89..777d2acd072950790e236012cee461386d71b807 100644
--- a/UI/CMakeLists.txt
+++ b/UI/CMakeLists.txt
@@ -54,6 +54,7 @@ elseif (APPLE)
 elseif(ANDROID)
    add_subdirectory(Android)
 else()
+    add_custom_target("ladybird_build_resource_files")
     # TODO: Check for other GUI frameworks here when we move them in-tree
     return()
 endif()
diff --git a/Utilities/test262-runner.cpp b/Utilities/test262-runner.cpp
index f9ffe7f4260ea82716daa34a3056e9d0284bff6e..90942b914051ff02392e15629065a53886110c39 100644
--- a/Utilities/test262-runner.cpp
+++ b/Utilities/test262-runner.cpp
@@ -548,17 +548,24 @@ static bool g_in_assert = false;
 #undef NDEBUG
 #include <assert.h>
 
-#ifdef AK_OS_MACOS
-extern "C" __attribute__((__noreturn__)) void __assert_rtn(char const* function, char const* file, int line, char const* assertion)
-#elifdef ASSERT_FAIL_HAS_INT /* Set by CMake */
-extern "C" __attribute__((__noreturn__)) void __assert_fail(char const* assertion, char const* file, int line, char const* function)
+#ifdef AK_OS_SERENITY
+void __assertion_failed(char const* assertion)
+{
+    handle_failed_assert(assertion);
+}
 #else
+#    ifdef AK_OS_MACOS
+extern "C" __attribute__((__noreturn__)) void __assert_rtn(char const* function, char const* file, int line, char const* assertion)
+#    elifdef ASSERT_FAIL_HAS_INT /* Set by CMake */
+extern "C" __attribute__((__noreturn__)) void __assert_fail(char const* assertion, char const* file, int line, char const* function)
+#    else
 extern "C" __attribute__((__noreturn__)) void __assert_fail(char const* assertion, char const* file, unsigned int line, char const* function)
-#endif
+#    endif
 {
     auto full_message = ByteString::formatted("{}:{}: {}: Assertion `{}' failed.", file, line, function, assertion);
     handle_failed_assert(full_message.characters());
 }
+#endif
 #pragma pop_macro("NDEBUG")
 
 constexpr int exit_wrong_arguments = 2;
